# CinePilot AI Agent Service - Local Environment Example
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file.

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Google GenAI SDK configuration
GOOGLE_GENAI_USE_VERTEXAI=true

# Authorized Gemini Model in Vertex AI
GEMINI_MODEL=gemini-2.5-flash

# ClickHouse Cloud Connection Settings
CLICKHOUSE_HOST=your-clickhouse-host.clickhouse.cloud
CLICKHOUSE_PORT=9440
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# Local server config (optional)
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=info
